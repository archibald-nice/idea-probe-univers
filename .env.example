# 复制为 .env 后填写：cp .env.example .env
DEEPSEEK_API_KEY=

# LLM 切换：deepseek | kimi（已拍板：DeepSeek 先行，质量不达标再切 Kimi）
LLM_PROVIDER=deepseek

# 可选：模型覆盖
DEEPSEEK_MODEL=deepseek-chat
KIMI_API_KEY=
KIMI_MODEL=kimi-k2-0711-preview

# Reddit 抓取通道：auto（默认，有凭据走 oauth）| oauth | rss
# 强烈建议配置 oauth（免费、5 分钟）：reddit.com/prefs/apps → create app → 选 script 类型，
# 把 web app 的 id（约 14 位）和 secret 填入下面两项。
REDDIT_TRANSPORT=auto
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 可选：代理（Clash 本机端口形如 http://127.0.0.1:7890；留空直连。urllib 自动读取）
HTTP_PROXY=
HTTPS_PROXY=

# 可选：失败告警 webhook（飞书自定义机器人地址；留空则仅日志+非零退出码）
ENGINE_ALERT_WEBHOOK=

# 可选：归档目录（默认 data；指向存量 archive.jsonl 所在目录即可无缝并入真实格式比对）
ARCHIVE_DIR=data
